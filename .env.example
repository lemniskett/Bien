# --- Required ---
# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Which AI CLI is the brain. No default — must be set explicitly. One of: claude | codex
AI_CLI=claude

# Model passed to the CLI (--model for claude, -m for codex). No default. e.g. haiku, sonnet, opus, gpt-5
AI_MODEL=haiku

# Timezone as a fixed UTC offset. Used to turn "5 AM" into absolute UTC. e.g. UTC+7, UTC-5, UTC+5:30
TIMEZONE_OFFSET=UTC+7

# --- Optional (sensible defaults shown) ---
# Directory that is the AI's home (its cwd). Reminders/schedules/notes live here.
WORKSPACE_DIR=./workspace

# Scheduler poll cadence (ms)
POLL_INTERVAL_MS=60000

# Reminder nag interval (ms) and max number of pings before giving up
NAG_INTERVAL_MS=300000
NAG_MAX=12

# Kill the AI CLI child if it runs longer than this (ms)
AI_TIMEOUT_MS=120000
